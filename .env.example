
# ==========================================
# TELIPORT - Self-Healing Machines
# Environment Configuration
# ==========================================

# Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# LangSmith - LLM tracing and evaluation
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=teliport-self-healing-machines

# Dashboard password (optional)
# Leave blank to disable the basic password gate.
TELIPORT_DASHBOARD_PASSWORD=

# Optional vector-based RAG
# Enable only if your implementation supports this setting.
USE_VECTOR_RETRIEVAL=false

# Application environment
APP_ENV=development

# streamlit run dashboard/app.py

# python simulate_stream.py --engine 1 --limit 50